# .env for the app repo's docker-compose.yml on the compose host.
# Store the filled-in content as an SSM SecureString (default name
# /ticketstage/trial/compose-env); the host writes it to the app directory at boot.
# Anything not set here falls back to the dev defaults in docker-compose.yml,
# which are NOT safe on a public endpoint: always set the four secrets below.

# Generate each with: openssl rand -hex 32
JWT_SECRET=
INTERNAL_API_KEY=
SECRET_HASH_KEY=
PASSWORD_PEPPER=

# Public URLs (frontend on S3/CloudFront or Cloudflare Pages, API via the tunnel)
FRONTEND_URL=https://trial.example.com
PUBLIC_API_URL=https://api-trial.example.com
VNPAY_RETURN_URL=https://api-trial.example.com/api/payment/return/vnpay
VNPAY_IPN_URL=https://api-trial.example.com/api/payment/webhooks/vnpay
MOMO_REDIRECT_URL=https://trial.example.com/payment/result
MOMO_IPN_URL=https://api-trial.example.com/api/payment/webhooks/momo

# Payment sandbox credentials (optional)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# Email (optional; without it emails stay queued in notification-service)
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

ADMIN_EMAIL=admin@ticketbooking.com
