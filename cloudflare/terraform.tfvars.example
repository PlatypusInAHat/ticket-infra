cloudflare_api_token = "replace_me"
cloudflare_zone_id   = "replace_me"

environment    = "ticketstage"
security_level = "medium"
bot_score_challenge_enabled = false
bot_score_threshold         = 30

dns_records = {
  api = {
    name    = "api"
    value   = "k8s-ticketstage-api-xxxxxxxx.us-east-1.elb.amazonaws.com"
    type    = "CNAME"
    proxied = true
  }
  www = {
    name    = "www"
    value   = "dxxxxxxxxxxxxx.cloudfront.net"
    type    = "CNAME"
    proxied = true
  }
}

# Enable during major on-sale windows when your Cloudflare plan supports Waiting Room.
waiting_rooms = {
  checkout = {
    name                 = "ticketstage-checkout-hot-sale"
    host                 = "www.ticketstage.example.com"
    path                 = "/checkout"
    total_active_users   = 1000
    new_users_per_minute = 200
    session_duration     = 5
    description          = "Protect checkout during high-demand ticket launches"
    suspended            = true
    json_response_enabled = true
    queueing_status_code = 200
  }
}
