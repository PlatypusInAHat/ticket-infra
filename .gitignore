**/.terraform/
*.tfstate
*.tfstate.*
crash.log
schema.json

# tfvars may hold secrets (e.g. cloudflare). Per-environment AWS tfvars contain
# sizing only (secrets come from TF_VAR_* env vars) and are tracked.
*.tfvars
!*.tfvars.example
!aws/terraform/environments/*/terraform.tfvars

# Real Kubernetes runtime secrets generated by scripts/stack.ps1
k8s/secrets/*.env

# Local AI agent instructions and generated skills
/AGENTS.md
/CLAUDE.md
/GEMINI.md
**/AGENTS.md
**/CLAUDE.md
**/GEMINI.md
.claude/skills/generated/
